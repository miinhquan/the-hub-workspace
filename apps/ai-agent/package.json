{
  "name": "@the-hub/ai-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "\u003e=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit \u0026\u0026 vite build \u0026\u0026 node scripts/build-worker.mjs",
    "lint": "eslint src worker tests scripts",
    "test": "vitest run",
    "check": "npm run lint \u0026\u0026 npm test \u0026\u0026 npm run build",
    "init:local": "node scripts/init-local.mjs",
    "format": "prettier --write src worker scripts tests *.json *.ts *.js"
  },
  "dependencies": {
    "lucide-react": "^0.563.0",
    "motion": "^12.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.4"
  }
}
